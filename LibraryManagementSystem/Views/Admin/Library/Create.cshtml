@model LibraryManagementSystem.ViewModels.Admin.LibraryCreateViewModel

@{
    ViewBag.Title = "Add New Library";
}

<link rel="stylesheet" href="~/Content/AdminForm.css" />

<div class="admin-page-banner">
    <h2>Add New Library</h2>
    <p>Add a new library to the system.</p>
</div>

<div class="admin-form-card">
    @using (Html.BeginForm("Create", "AdminLibrary", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Library Name *</label>
            @Html.TextBoxFor(m => m.Name, new { @class = "form-input", placeholder = "Enter library name" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="form-label">Location *</label>
            @Html.TextBoxFor(m => m.Location, new { @class = "form-input", placeholder = "Enter location" })
            @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label class="form-label">Operating Hours</label>
                @Html.TextBoxFor(m => m.OperatingHours, new { @class = "form-input", placeholder = "e.g. Mon-Fri 9AM-5PM" })
                @Html.ValidationMessageFor(m => m.OperatingHours, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label class="form-label">Contact Phone</label>
                @Html.TextBoxFor(m => m.ContactPhone, new { @class = "form-input", placeholder = "Enter phone number" })
                @Html.ValidationMessageFor(m => m.ContactPhone, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Contact Email</label>
            @Html.TextBoxFor(m => m.ContactEmail, new { @class = "form-input", placeholder = "email@example.com", type = "email" })
            @Html.ValidationMessageFor(m => m.ContactEmail, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="form-label">Description</label>
            @Html.TextAreaFor(m => m.Description, new { @class = "form-textarea", rows = 4, placeholder = "Enter library description" })
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-teal">Create Library</button>
            <a href="@Url.Action("Index", "AdminLibrary")" class="btn-cancel">Cancel</a>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
