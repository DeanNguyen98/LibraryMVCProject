@model IEnumerable<LibraryManagementSystem.Models.BorrowTransaction>

@{
    ViewBag.Title = "Manage Transactions";
}

<div class="page-content">
    <div class="settings-container">

        <div class="page-header">
            <h1>Manage Transactions</h1>
            <p class="subtitle">View and manage borrowing and returning records.</p>
        </div>

        <div class="top-actions">
            <input type="text"
                   placeholder="Search transactions..."
                   class="search-box" />
        </div>

        <table class="activity-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Member Name</th>
                    <th>Book Title</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Fine</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var transaction in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@transaction.User.FullName</td>
                        <td>@transaction.Book.Title</td>
                        <td>@transaction.BorrowedAt.ToString("dd MMM yyyy")</td>
                        <td>@transaction.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (transaction.Status == LibraryManagementSystem.Models.BorrowStatus.Borrowed)
                            {
                                <span class="status-borrowed">Borrowed</span>
                            }
                            else if (transaction.Status == LibraryManagementSystem.Models.BorrowStatus.Overdue)
                            {
                                <span class="status-overdue">Overdue</span>
                            }
                            else if (transaction.Status == LibraryManagementSystem.Models.BorrowStatus.Returned)
                            {
                                <span class="status-returned">Returned</span>
                            }
                            else
                            {
                                <span>@transaction.Status</span>
                            }
                        </td>
                        <td>
                            @if (transaction.FineAmount > 0)
                            {
                                <span class="fine-amount">$@transaction.FineAmount.ToString("0.00")</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            @if (transaction.Status != LibraryManagementSystem.Models.BorrowStatus.Returned)
                            {
                                using (Html.BeginForm("ConfirmReturn", "AdminTransactions", new { id = transaction.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="confirm-return-btn"
                                            onclick="return confirm('Confirm return of this book?')">
                                        Confirm Return
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="returned-label">Returned</span>
                            }
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>

    </div>
</div>