                    <td>C# Programming</td>
                    <td>10 May 2026</td>
                    <td>24 May 2026</td>

                    <td>
                        <span class="status-borrowed">
                            Borrowed
                        </span>
                    </td>

                    <td>
                        <button class="edit-btn">
                            Edit
                        </button>

                        <button class="delete-btn">
                            Delete
                        </button>
                    </td>
                </tr>

