@model LibraryManagementSystem.ViewModels.Admin.BorrowSettingDetailsViewModel

@{
    ViewBag.Title = "Delete Borrow Setting";
}

<div class="page-content">
    <!-- Teal Header Banner -->
    <div style="background: linear-gradient(135deg, #459D7A 0%, #3D8B6A 100%); padding: 30px; border-radius: 12px; color: white; margin-bottom: 30px;">
        <h1 style="margin: 0 0 8px 0; font-size: 32px;">Delete Borrow Setting</h1>
        <p style="margin: 0; font-size: 16px; opacity: 0.9;">Are you sure you want to delete this borrow setting?</p>
    </div>

    <div class="settings-container">
        <div style="background: #fef2f2; border-left: 4px solid #ef4444; padding: 16px; border-radius: 6px; margin-bottom: 25px;">
            <p style="margin: 0; color: #991b1b; font-weight: 600;">⚠️ Warning: This action cannot be undone.</p>
        </div>

        @if (Model.Status == "Active")
        {
            <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 16px; border-radius: 6px; margin-bottom: 25px;">
                <p style="margin: 0; color: #92400e; font-weight: 600;">⚠️ This is the active borrow setting. You cannot delete it. Please activate another setting first.</p>
            </div>
        }

        <table class="activity-table">
            <tbody>
                <tr>
                    <th style="width: 250px;">Setting Name</th>
                    <td><strong>@Model.SettingName</strong></td>
                </tr>
                <tr>
                    <th>Loan Duration</th>
                    <td>@Model.LoanDurationDays days</td>
                </tr>
                <tr>
                    <th>Renewal Limit</th>
                    <td>@Model.RenewalLimit</td>
                </tr>
                <tr>
                    <th>Fine Per Day</th>
                    <td>$@Model.OverdueFinePerDay.ToString("0.00")</td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>
                        @if (Model.Status == "Active")
                        {
                            <span class="status-returned">Active</span>
                        }
                        else
                        {
                            <span class="status-overdue">Inactive</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>

        @using (Html.BeginForm("Delete", "AdminBorrowSettings", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", Model.Id)

            <div style="margin-top: 25px;">
                @if (Model.Status != "Active")
                {
                    <button type="submit" class="delete-btn" style="text-decoration: none; display: inline-block;">Confirm Delete</button>
                }
                <a href="@Url.Action("Index", "AdminBorrowSettings")" class="edit-btn" style="text-decoration: none;">Cancel</a>
            </div>
        }
    </div>
</div>