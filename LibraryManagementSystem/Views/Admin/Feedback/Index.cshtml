@model IEnumerable<LibraryManagementSystem.Models.Feedback>
@{
    ViewBag.Title = "Feedback & Ratings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int? ratingFilter = ViewBag.RatingFilter;
}

<!-- Teal Header Banner -->
<div class="admin-page-banner">
    <h2>Feedback &amp; Ratings</h2>
    <p>View and manage member reviews and book ratings</p>
</div>

<div class="admin-page-body">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Stat Cards -->
    <div class="admin-stat-row">
        <div class="admin-stat-card">
            <span class="admin-stat-number">@ViewBag.TotalCount</span>
            <span class="admin-stat-label">Total Reviews</span>
        </div>
        @if (ViewBag.AverageRating != null)
        {
            <div class="admin-stat-card">
                <span class="admin-stat-number">@ViewBag.AverageRating</span>
                <span class="admin-stat-label">Avg Rating</span>
            </div>
        }
    </div>

    <!-- Rating Filter -->
    <div class="admin-filter-row">
        <span class="admin-filter-label">Filter by rating:</span>
        <a href="@Url.Action("Index")" class="admin-filter-btn @(ratingFilter == null ? "active" : "")">All</a>
        @for (int i = 1; i <= 5; i++)
        {
            int stars = i;
            <a href="@Url.Action("Index", new { ratingFilter = stars })"
               class="admin-filter-btn @(ratingFilter == stars ? "active" : "")">
                @stars star(s)
            </a>
        }
    </div>

    <!-- Table -->
    @if (!Model.Any())
    {
        <div class="admin-empty-state">
            No feedback found@(ratingFilter.HasValue ? " for " + ratingFilter + " star(s)" : "").
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Book Title</th>
                        <th>Member</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="td-book">@(item.Book != null ? item.Book.Title : "—")</td>
                            <td>@(item.User != null ? item.User.Email : "—")</td>
                            <td>
                                <div class="star-row">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <span class="@(s <= item.Rating ? "star-on" : "star-off")">&#9733;</span>
                                    }
                                </div>
                            </td>
                            <td class="td-comment">
                                @if (!string.IsNullOrEmpty(item.Comment) && item.Comment.Length > 80)
                                {
                                    @item.Comment.Substring(0, 80)<text>…</text>
                                }
                                else
                                {
                                    @(item.Comment ?? "—")
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @using (Html.BeginForm("Delete", "AdminFeedback", new { id = item.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-delete-feedback"
                                            onclick="return confirm('Are you sure you want to delete this feedback?');">
                                        Delete
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    /* Banner */
    .admin-page-banner {
        background: #2e8b7a;
        color: #fff;
        padding: 28px 32px;
        border-radius: 8px;
        margin-bottom: 28px;
    }

        .admin-page-banner h2 {
            margin: 0 0 4px;
            font-size: 24px;
            font-weight: 700;
            color: #fff;
        }

        .admin-page-banner p {
            margin: 0;
            font-size: 14px;
            opacity: 0.88;
        }

    /* Body */
    .admin-page-body {
        padding-bottom: 40px;
    }

    /* Stat Cards */
    .admin-stat-row {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
    }

    .admin-stat-card {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 14px 28px;
        text-align: center;
        min-width: 110px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .admin-stat-number {
        display: block;
        font-size: 26px;
        font-weight: 700;
        color: #2e8b7a;
    }

    .admin-stat-label {
        display: block;
        font-size: 11px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 2px;
    }

    /* Filter */
    .admin-filter-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .admin-filter-label {
        font-size: 13px;
        font-weight: 600;
        color: #888;
    }

    .admin-filter-btn {
        padding: 6px 16px;
        border-radius: 20px;
        border: 1px solid #ccc;
        background: #fff;
        color: #555;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.15s;
    }

        .admin-filter-btn:hover {
            background: #e8f5f2;
            color: #2e8b7a;
            border-color: #2e8b7a;
            text-decoration: none;
        }

        .admin-filter-btn.active {
            background: #2e8b7a;
            color: #fff;
            border-color: #2e8b7a;
        }

    /* Table */
    .admin-table-wrap {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        margin: 0;
    }

        .admin-table thead tr {
            background: #f5f5f5;
        }

        .admin-table thead th {
            padding: 12px 16px;
            font-size: 11px;
            font-weight: 700;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            border-bottom: 1px solid #eee;
        }

        .admin-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #f0f0f0;
            color: #333;
            vertical-align: middle;
        }

        .admin-table tbody tr:last-child td {
            border-bottom: none;
        }

        .admin-table tbody tr:hover {
            background: #f9fffe;
        }

    .td-book {
        font-weight: 600;
        color: #2e8b7a;
    }

    .td-comment {
        color: #666;
        font-style: italic;
    }

    /* Stars */
    .star-row {
        display: flex;
        gap: 2px;
    }

    .star-on {
        color: #f39c12;
        font-size: 16px;
    }

    .star-off {
        color: #ddd;
        font-size: 16px;
    }

    /* Delete button */
    .btn-delete-feedback {
        background: #e74c3c;
        color: #fff;
        border: none;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 13px;
        cursor: pointer;
        transition: background 0.15s;
    }

        .btn-delete-feedback:hover {
            background: #c0392b;
        }

    /* Empty state */
    .admin-empty-state {
        background: #fff;
        border-radius: 8px;
        padding: 40px;
        text-align: center;
        color: #aaa;
        font-size: 15px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.07);
    }
</style>
