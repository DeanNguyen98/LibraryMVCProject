@model LibraryManagementSystem.ViewModels.Admin.ManageBooksViewModel

@{
    ViewBag.Title = "Manage Books";
}

<link rel="stylesheet" href="~/Content/AdminBooks.css" />

<div class="admin-page-banner">
    <h2>Manage Books</h2>
    <p>Add and manage books available in the library.</p>
</div>

<div class="admin-page-body">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <div class="table-toolbar">
        @using (Html.BeginForm("Index", "AdminBooks", FormMethod.Get))
        {
            <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search books..." class="toolbar-search" />
        }
        <a href="@Url.Action("Create", "AdminBooks")" class="btn-teal">+ Add New Book</a>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Book Title</th>
                    <th>Author</th>
                    <th>Genre</th>
                    <th>Available Copies</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Books != null && Model.Books.Any())
                {
                    int i = 1;
                    foreach (var book in Model.Books)
                    {
                        <tr>
                            <td>@i</td>
                            <td class="td-primary">@book.Title</td>
                            <td>@book.Authors</td>
                            <td>@book.Genres</td>
                            <td>@book.AvailableCopies / @book.TotalCopies</td>
                            <td>
                                @if (book.AvailableCopies > 0)
                                {
                                    <span class="badge-available">Available</span>
                                }
                                else
                                {
                                    <span class="badge-unavailable">Unavailable</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Details", "AdminBooks", new { id = book.Id })" class="btn-sm-grey">View</a>
                                <a href="@Url.Action("Edit", "AdminBooks", new { id = book.Id })" class="btn-sm-teal">Edit</a>
                                <a href="@Url.Action("Delete", "AdminBooks", new { id = book.Id })" class="btn-sm-danger">Delete</a>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="td-empty">No books found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
