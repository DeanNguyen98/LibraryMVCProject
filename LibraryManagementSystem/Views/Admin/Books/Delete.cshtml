@model LibraryManagementSystem.ViewModels.Admin.BookDetailsViewModel

@{
    ViewBag.Title = "Delete Book";
}

<div class="page-content">
    <!-- Teal Header Banner -->
    <div style="background: linear-gradient(135deg, #459D7A 0%, #3D8B6A 100%); padding: 30px; border-radius: 12px; color: white; margin-bottom: 30px;">
        <h1 style="margin: 0 0 8px 0; font-size: 32px;">Delete Book</h1>
        <p style="margin: 0; font-size: 16px; opacity: 0.9;">Are you sure you want to delete this book?</p>
    </div>

    <div class="settings-container">
        <div style="background: #fef2f2; border-left: 4px solid #ef4444; padding: 16px; border-radius: 6px; margin-bottom: 25px;">
            <p style="margin: 0; color: #991b1b; font-weight: 600;">⚠️ Warning: This action cannot be undone.</p>
        </div>

        <table class="activity-table">
            <tbody>
                <tr>
                    <th style="width: 200px;">Book Title</th>
                    <td>@Model.Title</td>
                </tr>
                <tr>
                    <th>Authors</th>
                    <td>@Model.Authors</td>
                </tr>
                <tr>
                    <th>ISBN</th>
                    <td>@Model.Isbn</td>
                </tr>
                <tr>
                    <th>Library</th>
                    <td>@Model.LibraryName</td>
                </tr>
                <tr>
                    <th>Created Date</th>
                    <td>@Model.CreatedAt.ToString("dd MMM yyyy")</td>
                </tr>
            </tbody>
        </table>

        @using (Html.BeginForm("Delete", "AdminBooks", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", Model.Id)

            <div style="margin-top: 25px;">
                <button type="submit" class="delete-btn" style="text-decoration: none; display: inline-block;">Confirm Delete</button>
                <a href="@Url.Action("Index", "AdminBooks")" class="edit-btn" style="text-decoration: none;">Cancel</a>
            </div>
        }
    </div>
</div>