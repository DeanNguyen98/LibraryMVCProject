@model LibraryManagementSystem.ViewModels.Admin.LibraryDetailsViewModel

@{
    ViewBag.Title = "Library Details";
}

<div class="page-content">
    <!-- Teal Header Banner -->
    <div style="background: linear-gradient(135deg, #459D7A 0%, #3D8B6A 100%); padding: 30px; border-radius: 12px; color: white; margin-bottom: 30px;">
        <h1 style="margin: 0 0 8px 0; font-size: 32px;">Library Details</h1>
        <p style="margin: 0; font-size: 16px; opacity: 0.9;">View detailed information about the selected library.</p>
    </div>

    <div class="settings-container">
        <table class="activity-table">
            <tbody>
                <tr>
                    <th style="width: 200px;">Library Name</th>
                    <td>@Model.Name</td>
                </tr>

                <tr>
                    <th>Location</th>
                    <td>@Model.Location</td>
                </tr>

                <tr>
                    <th>Operating Hours</th>
                    <td>@(string.IsNullOrEmpty(Model.OperatingHours) ? "—" : Model.OperatingHours)</td>
                </tr>

                <tr>
                    <th>Contact Email</th>
                    <td>@(string.IsNullOrEmpty(Model.ContactEmail) ? "—" : Model.ContactEmail)</td>
                </tr>

                <tr>
                    <th>Contact Phone</th>
                    <td>@(string.IsNullOrEmpty(Model.ContactPhone) ? "—" : Model.ContactPhone)</td>
                </tr>

                <tr>
                    <th>Total Books</th>
                    <td>
                        @Model.TotalBooks
                        @if (Model.TotalBooks > 0)
                        {
                            <span class="status-returned" style="margin-left: 10px;">@Model.TotalBooks book(s)</span>
                        }
                    </td>
                </tr>

                <tr>
                    <th>Created Date</th>
                    <td>@Model.CreatedAt.ToString("dd MMM yyyy")</td>
                </tr>

                <tr>
                    <th>Description</th>
                    <td>@(string.IsNullOrEmpty(Model.Description) ? "No description available" : Model.Description)</td>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 25px;">
            <a href="@Url.Action("Edit", "AdminLibrary", new { id = Model.Id })" class="edit-btn" style="text-decoration: none;">Edit Library</a>
            <a href="@Url.Action("Index", "AdminLibrary")" class="add-btn" style="text-decoration: none;">Back to List</a>
        </div>
    </div>
</div>