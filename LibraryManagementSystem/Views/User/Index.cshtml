@model LibraryManagementSystem.ViewModels.User.UserHomeViewModel
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/UserHome.css" />

<div class="user-home">

    <div class="welcome-banner">
        <h2>Welcome, @Model.UserFullName</h2>
        <p>Manage your books and borrowing activities</p>
    </div>

    <h3 class="section-heading">Group Members</h3>
    <table class="members-table">
        <thead>
            <tr>
                <th>No</th>
                <th>Full Name</th>
                <th>Student ID</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>Md Akash Hasan</td>
                <td>20031669</td>
                <td>Frontend User Pages</td>
            </tr>
            <tr>
                <td>2</td>
                <td>Member Two</td>
                <td>2003XXXX</td>
                <td>Frontend Admin Pages</td>
            </tr>
            <tr>
                <td>3</td>
                <td>Member Three</td>
                <td>2003XXXX</td>
                <td>Backend</td>
            </tr>
            <tr>
                <td>4</td>
                <td>Member Four</td>
                <td>2003XXXX</td>
                <td>Database</td>
            </tr>
        </tbody>
    </table>

    <div class="stats-row">
        <div class="info-card card-blue">
            <p class="card-label">Currently Borrowed</p>
            <h3 class="card-number">@Model.CurrentlyBorrowedCount</h3>
            <p class="card-note">Books checked out</p>
        </div>
        <div class="info-card card-green">
            <p class="card-label">Available Books</p>
            <h3 class="card-number">@Model.AvailableBooksCount</h3>
            <p class="card-note">Ready to borrow</p>
        </div>
        <div class="info-card card-red">
            <p class="card-label">Overdue Books</p>
            <h3 class="card-number">@Model.OverdueBooksCount</h3>
            <p class="card-note">Requires attention</p>
        </div>
    </div>

    <div class="section-top">
        <h3>Trending Books</h3>
        <a href="/User/Books">View All</a>
    </div>

    <div class="book-row">
        @foreach (var book in Model.TrendingBooks)
        {
            <div class="book-box">
                <p class="book-name">@book.Title</p>
                <p class="book-writer">@book.Authors</p>
                @if (book.IsAvailable)
                {
                    <span class="tag tag-green">Available</span>
                }
                else
                {
                    <span class="tag tag-yellow">Borrowed</span>
                }
            </div>
        }
    </div>

    @if (Model.OverdueNotices.Count > 0)
    {
        foreach (var notice in Model.OverdueNotices)
        {
            <div class="warning-box">
                <strong>Overdue Notice:</strong>
                @notice.BookTitle was due @notice.DueDate.ToString("d MMM yyyy"). Fine:
                $@notice.FineAmount.ToString("0.00")
            </div>
        }
    }

</div>