@model LibraryManagementSystem.ViewModels.User.UserTransactionsViewModel

@{
    ViewBag.Title = "Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/UserTransactions.css" />

<div class="transactions-page">

    <div class="page-header">
        <h2>My Transactions</h2>
        <p>View and manage your borrowed books</p>
    </div>

    <div class="tab-buttons">
        <button class="tab-btn active"
                onclick="showTab('active', this)">
            Active Borrowed
        </button>
        <button class="tab-btn"
                onclick="showTab('overdue', this)">
            Overdue
        </button>
        <button class="tab-btn"
                onclick="showTab('history', this)">
            History
        </button>
    </div>

    <div id="tab-active" class="tab-panel">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Return Location</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ActiveBorrows)
                {
                    <tr>
                        <td>@item.BookTitle</td>
                        <td>@item.BorrowedAt.ToString("dd MMM yyyy")</td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td>@item.ReturnLocation</td>
                        <td class="action-cell">
                            @using (Html.BeginForm("ExtendBorrow", "User",
                                FormMethod.Post, new { style = "display:inline;" }))
                            {
                                @Html.Hidden("transactionId", item.TransactionId)
                                <button type="submit" class="btn btn-outline">
                                    Extend
                                </button>
                            }
                            <button class="btn btn-feedback"
                                    onclick="openFeedback('@item.BookTitle',
                                        @item.BookId)">
                                Leave Feedback
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="tab-overdue" class="tab-panel" style="display:none;">
        @if (Model.OverdueItems.Count > 0)
        {
            <div class="notice-box">
                You have @Model.OverdueItems.Count overdue book(s). Please
                return or pay the fine as soon as possible.
            </div>
        }
        <table class="data-table">
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Due Date</th>
                    <th>Days Overdue</th>
                    <th>Fine Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OverdueItems)
                {
                    <tr>
                        <td>@item.BookTitle</td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td class="overdue-days">@item.DaysOverdue</td>
                        <td class="fine-amount">
                            $@item.FineAmount.ToString("0.00")
                        </td>
                        <td>
                            @using (Html.BeginForm("PayFine", "User",
                                FormMethod.Post, new { style = "display:inline;" }))
                            {
                                @Html.Hidden("transactionId", item.TransactionId)
                                <button type="submit" class="btn btn-danger">
                                    Pay Fine
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="tab-history" class="tab-panel" style="display:none;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Return Status</th>
                    <th>Return Date</th>
                    <th>Fine Paid</th>
                    <th>Feedback</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.HistoryItems)
                {
                    <tr>
                        <td>@item.BookTitle</td>
                        <td>
                            @if (item.ReturnedOnTime)
                            {
                                <span class="tag tag-green">On Time</span>
                            }
                            else
                            {
                                <span class="tag tag-red">Late</span>
                            }
                        </td>
                        <td>@item.ReturnedAt.ToString("dd MMM yyyy")</td>
                        <td>$@item.FinePaid.ToString("0.00")</td>
                        <td>
                            @if (item.HasFeedback)
                            {
                                <span class="feedback-given">
                                    Rating: @item.FeedbackRating
                                    - @item.FeedbackComment
                                </span>
                            }
                            else
                            {
                                <span class="no-feedback">No feedback yet</span>
                            }
                        </td>
                        <td>
                            @if (item.HasFeedback)
                            {
                                <span class="submitted-label">Submitted</span>
                            }
                            else
                            {
                                <button class="btn btn-success"
                                        onclick="openFeedback('@item.BookTitle',
                                            @item.BookId)">
                                    Leave Feedback
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<script>
    var currentBookId = null;

    var modal = document.createElement('div');
    modal.id = 'feedback-modal';
    modal.innerHTML = '\
        <div id="modal-overlay"></div>\
        <div id="modal-box">\
            <h4 id="modal-title-text">Leave Feedback</h4>\
            <p id="modal-book-name"></p>\
            <form id="feedback-form" method="post" action="/User/SubmitFeedback">\
                <div class="form-group">\
                    <label class="form-label">Rating</label>\
                    <div class="star-row">\
                        <label><input type="radio" name="rating" value="1" /> 1</label>\
                        <label><input type="radio" name="rating" value="2" /> 2</label>\
                        <label><input type="radio" name="rating" value="3" /> 3</label>\
                        <label><input type="radio" name="rating" value="4" /> 4</label>\
                        <label><input type="radio" name="rating" value="5" checked /> 5</label>\
                    </div>\
                </div>\
                <div class="form-group">\
                    <label class="form-label">Comment</label>\
                    <textarea id="feedback-comment" name="comment"\
                        class="form-textarea"\
                        placeholder="Write your review here..."></textarea>\
                </div>\
                <input type="hidden" name="bookId" id="feedback-book-id" />\
                <div class="modal-buttons">\
                    <button type="submit" class="btn btn-success">Submit</button>\
                    <button type="button" class="btn btn-outline"\
                            onclick="closeFeedback()">Cancel</button>\
                </div>\
            </form>\
        </div>';

    modal.style.cssText =
        'display:none; position:fixed; top:0; left:0;' +
        'width:100%; height:100%; z-index:99999;' +
        'background-color:rgba(0,0,0,0.6);';

    var box = modal.querySelector('#modal-box');
    box.style.cssText =
        'position:fixed; top:50%; left:50%;' +
        'transform:translate(-50%,-50%);' +
        'background:#ffffff; padding:24px;' +
        'border-radius:8px; width:400px;' +
        'z-index:100000; border:1px solid #dddddd;' +
        'font-family:Arial,sans-serif;';

    var titleText = modal.querySelector('#modal-title-text');
    titleText.style.cssText =
        'font-size:14px; color:#222222; margin:0 0 4px 0;';

    var bookName = modal.querySelector('#modal-book-name');
    bookName.style.cssText =
        'font-size:12px; color:#2a8f7e; font-weight:bold; margin:0 0 16px 0;';

    document.body.appendChild(modal);

    function showTab(tabName, clickedButton) {
        var panels = document.querySelectorAll('.tab-panel');
        for (var i = 0; i < panels.length; i++) {
            panels[i].style.display = 'none';
        }
        var buttons = document.querySelectorAll('.tab-btn');
        for (var j = 0; j < buttons.length; j++) {
            buttons[j].classList.remove('active');
        }
        document.getElementById('tab-' + tabName).style.display = 'block';
        clickedButton.classList.add('active');
    }

    function openFeedback(bookTitle, bookId) {
        modal.querySelector('#modal-book-name').innerText = bookTitle;
        modal.querySelector('#feedback-book-id').value = bookId;
        modal.querySelector('#feedback-comment').value = '';
        modal.querySelector('input[name="rating"][value="5"]').checked = true;
        modal.style.display = 'block';
        document.body.style.overflow = 'hidden';
    }

    function closeFeedback() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }
</script>