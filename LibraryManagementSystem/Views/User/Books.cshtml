@{
    ViewBag.Title = "Books";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/UserBooks.css" />

<div class="books-page">

    <div class="page-header">
        <h2>Browse Books</h2>
        <p>Search and borrow from our collection</p>
    </div>

    <div class="search-area">
        <input type="text"
               placeholder="Search by title or author"
               class="search-input" />
        <select class="filter-select">
            <option value="">All Genres</option>
            <option value="selfhelp">Self Help</option>
            <option value="fantasy">Fantasy</option>
            <option value="romance">Romance</option>
            <option value="finance">Finance</option>
            <option value="technology">Technology</option>
            <option value="science">Science</option>
            <option value="history">History</option>
            <option value="mystery">Mystery</option>
        </select>
    </div>

    <table class="books-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><a href="/User/BookDetails" class="book-link">Atomic Habits</a></td>
                <td>James Clear</td>
                <td>Self Help</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
            <tr>
                <td>Harry Potter and the Philosophers Stone</td>
                <td>J.K. Rowling</td>
                <td>Fantasy</td>
                <td><span class="tag tag-yellow">Borrowed</span></td>
                <td><button class="btn btn-secondary">Reserve</button></td>
            </tr>
            <tr>
                <td>The Fault in Our Stars</td>
                <td>John Green</td>
                <td>Romance</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
            <tr>
                <td>The Hunger Games</td>
                <td>Suzanne Collins</td>
                <td>Dystopian</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
            <tr>
                <td>Rich Dad Poor Dad</td>
                <td>Robert Kiyosaki</td>
                <td>Finance</td>
                <td><span class="tag tag-blue">Reserved</span></td>
                <td><button class="btn btn-disabled" disabled>Unavailable</button></td>
            </tr>
            <tr>
                <td>Web Design with HTML and CSS</td>
                <td>David Lee</td>
                <td>Technology</td>
                <td><span class="tag tag-red">Overdue</span></td>
                <td><button class="btn btn-secondary">Reserve</button></td>
            </tr>
            <tr>
                <td>To Kill a Mockingbird</td>
                <td>Harper Lee</td>
                <td>Classic</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
            <tr>
                <td>The Great Gatsby</td>
                <td>F. Scott Fitzgerald</td>
                <td>Classic</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
            <tr>
                <td>Thinking Fast and Slow</td>
                <td>Daniel Kahneman</td>
                <td>Psychology</td>
                <td><span class="tag tag-yellow">Borrowed</span></td>
                <td><button class="btn btn-secondary">Reserve</button></td>
            </tr>
            <tr>
                <td>The Alchemist</td>
                <td>Paulo Coelho</td>
                <td>Fiction</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
            <tr>
                <td>Sapiens</td>
                <td>Yuval Noah Harari</td>
                <td>History</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
            <tr>
                <td>The Power of Now</td>
                <td>Eckhart Tolle</td>
                <td>Self Help</td>
                <td><span class="tag tag-blue">Reserved</span></td>
                <td><button class="btn btn-disabled" disabled>Unavailable</button></td>
            </tr>
            <tr>
                <td>Introduction to Programming</td>
                <td>Walter Savitch</td>
                <td>Technology</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
            <tr>
                <td>The Da Vinci Code</td>
                <td>Dan Brown</td>
                <td>Mystery</td>
                <td><span class="tag tag-yellow">Borrowed</span></td>
                <td><button class="btn btn-secondary">Reserve</button></td>
            </tr>
            <tr>
                <td>A Brief History of Time</td>
                <td>Stephen Hawking</td>
                <td>Science</td>
                <td><span class="tag tag-green">Available</span></td>
                <td><button class="btn btn-primary">Borrow</button></td>
            </tr>
        </tbody>
    </table>

</div>