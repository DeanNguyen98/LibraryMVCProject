@model LibraryManagementSystem.ViewModels.User.UserBooksViewModel
@{
    ViewBag.Title = "Books";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/UserBooks.css" />

<div class="books-page">

    <div class="page-header">
        <h2>Browse Books</h2>
        <p>Search and borrow from our collection</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @using (Html.BeginForm("Books", "User", FormMethod.Get, new { @class = "search-area" }))
    {
        <input type="text"
               name="search"
               value="@Model.SearchQuery"
               placeholder="Search by title or author"
               class="search-input" />
        <select name="genre" class="filter-select" onchange="this.form.submit()">
            <option value="">All Genres</option>
            @foreach (var g in Model.Genres)
            {
                <option value="@g" @(g == Model.SelectedGenre ? "selected" : "")>@g</option>
            }
        </select>
        <button type="submit" style="display:none"></button>
    }

    <table class="books-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>
                        <a href="/User/BookDetails?id=@book.Id" class="book-link">@book.Title</a>
                    </td>
                    <td>@book.Authors</td>
                    <td>@book.Genre</td>
                    <td>
                        @switch (book.Status)
                        {
                            case "Available":
                                <span class="tag tag-green">Available</span>
                                break;
                            case "Borrowed":
                                <span class="tag tag-yellow">Borrowed by You</span>
                                break;
                            case "Unavailable":
                                <span class="tag tag-grey">Unavailable</span>
                                break;
                            case "Overdue":
                                <span class="tag tag-red">Overdue</span>
                                break;
                        }
                    </td>
                    <td>
                        @switch (book.Status)
                        {
                            case "Available":
                                if (Model.AtBorrowLimit)
                                {
                                    <button class="book-btn book-btn-disabled" disabled title="You have reached your borrowing limit">Limit Reached</button>
                                }
                                else
                                {
                                    <button class="book-btn book-btn-primary" onclick="openBorrowModal(@book.Id, '@Html.Raw(Html.Encode(book.Title))', @Model.LoanDurationDays)">Borrow</button>
                                }
                                break;
                            case "Borrowed":
                                <button class="book-btn book-btn-disabled" disabled>Borrowed</button>
                                break;
                            case "Unavailable":
                                <button class="book-btn book-btn-secondary" onclick="openReserveModal(@book.Id, '@Html.Raw(Html.Encode(book.Title))')">Reserve</button>
                                break;
                            case "Overdue":
                                <button class="book-btn book-btn-disabled" disabled>Overdue</button>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="modal fade" id="borrowModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Borrow</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>You are about to borrow: <strong id="modalBookTitle"></strong></p>
                    <p>Duration: <strong id="modalDuration"></strong></p>
                    <p>Due Date: <strong id="modalDueDate"></strong></p>
                </div>
                <div class="modal-footer">
                    @using (Html.BeginForm("BorrowBook", "User", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" id="modalBookId" />
                        <input type="hidden" name="returnUrl" value="/User/Books" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="book-btn book-btn-primary">Confirm</button>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

    <div class="modal fade" id="reserveModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Reservation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>You are about to reserve: <strong id="reserveModalBookTitle"></strong></p>
                    <p>Your reservation will expire in 7 days.</p>
                </div>
                <div class="modal-footer">
                    @using (Html.BeginForm("ReserveBook", "User", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" id="reserveModalBookId" />
                        <input type="hidden" name="returnUrl" value="/User/Books" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="book-btn book-btn-secondary">Confirm</button>
                    }
                </div>
            </div>
        </div>
    </div>

@section scripts {
    <script>
        function openBorrowModal(bookId, bookTitle, loanDays) {
            document.getElementById('modalBookId').value = bookId;
            document.getElementById('modalBookTitle').textContent = bookTitle;
            document.getElementById('modalDuration').textContent = loanDays + ' days';
            var due = new Date();
            due.setDate(due.getDate() + loanDays);
            document.getElementById('modalDueDate').textContent = due.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
            new bootstrap.Modal(document.getElementById('borrowModal')).show();
        }
        function openReserveModal(bookId, bookTitle) {
            document.getElementById('reserveModalBookId').value = bookId;
            document.getElementById('reserveModalBookTitle').textContent = bookTitle;
            new bootstrap.Modal(document.getElementById('reserveModal')).show();
        }
    </script>
}