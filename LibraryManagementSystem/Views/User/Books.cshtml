@model LibraryManagementSystem.ViewModels.User.UserBooksViewModel
@{
    ViewBag.Title = "Books";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/UserBooks.css" />

<div class="books-page">

    <div class="page-header">
        <h2>Browse Books</h2>
        <p>Search and borrow from our collection</p>
    </div>

    @using (Html.BeginForm("Books", "User", FormMethod.Get, new { @class = "search-area" }))
    {
        <input type="text"
               name="search"
               value="@Model.SearchQuery"
               placeholder="Search by title or author"
               class="search-input" />
        <select name="genre" class="filter-select" onchange="this.form.submit()">
            <option value="">All Genres</option>
            @foreach (var g in Model.Genres)
            {
                <option value="@g" @(g == Model.SelectedGenre ? "selected" : "")>@g</option>
            }
        </select>
        <button type="submit" style="display:none"></button>
    }

    <table class="books-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>
                        <a href="/User/BookDetails?id=@book.Id" class="book-link">@book.Title</a>
                    </td>
                    <td>@book.Authors</td>
                    <td>@book.Genre</td>
                    <td>
                        @switch (book.Status)
                        {
                            case "Available":
                                <span class="tag tag-green">Available</span>
                                break;
                            case "Borrowed":
                                <span class="tag tag-yellow">Borrowed</span>
                                break;
                            case "Reserved":
                                <span class="tag tag-blue">Reserved</span>
                                break;
                            case "Overdue":
                                <span class="tag tag-red">Overdue</span>
                                break;
                        }
                    </td>
                    <td>
                        @switch (book.Status)
                        {
                            case "Available":
                                <button class="btn btn-primary">Borrow</button>
                                break;
                            case "Borrowed":
                            case "Overdue":
                                <button class="btn btn-secondary">Reserve</button>
                                break;
                            case "Reserved":
                                <button class="btn btn-disabled" disabled>Unavailable</button>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>