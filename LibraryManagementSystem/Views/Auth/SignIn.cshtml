@{
    ViewBag.Title = "Sign In";
}

<link rel="stylesheet" href="~/Content/SignIn.css" />

<div class="signin-page">

    <div class="signin-form-section">
        <h2>Sign In</h2>
        <p style="font-size:13px; color:#666666; margin-bottom:16px;">Please sign in to access the library system.</p>

        @if (TempData["SignInError"] != null)
        {
            <p class="text-danger">@TempData["SignInError"]</p>
        }

        @using (Html.BeginForm("SignIn", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div>
                <label>Email</label>
                <input type="email" name="Email" class="form-control" />
            </div>
            <div>
                <label>Password</label>
                <input type="password" name="Password" class="form-control" />
            </div>
            <br />
            <button type="submit" class="btn btn-primary">Sign In</button>
            <a href="/Auth/AdminSignIn" class="btn btn-secondary">Login as Admin</a>
        }

        <div class="signin-footer">
            <p>Don't have an account? <a href="/Auth/SignUp">Sign Up</a></p>
        </div>
    </div>

</div>
