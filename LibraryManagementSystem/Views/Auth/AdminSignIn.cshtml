@{
    ViewBag.Title = "Admin Sign In";
}

<link rel="stylesheet" href="~/Content/SignIn.css" />

<div class="signin-page">

    <div class="signin-form-section admin-form">
        <h2>Admin Sign In</h2>

        <div class="alert alert-info" style="font-size: 0.9rem;">
            <strong>Note for assessor:</strong> For the purpose of this assignment, an admin account has been created automatically on application startup.<br />
            <strong>Email:</strong> admin@library.com<br />
            <strong>Password:</strong> Admin@123
        </div>

        @if (TempData["AdminSignInError"] != null)
        {
            <p class="text-danger">@TempData["AdminSignInError"]</p>
        }

        @using (Html.BeginForm("AdminSignIn", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div>
                <label>Email</label>
                <input type="email" name="Email" class="form-control" />
            </div>
            <div>
                <label>Password</label>
                <input type="password" name="Password" class="form-control" />
            </div>
            <br />
            <button type="submit" class="btn btn-primary">Sign In</button>
            <a href="/Auth/SignIn" class="btn btn-link">Back to Member Sign In</a>
        }
    </div>

</div>
