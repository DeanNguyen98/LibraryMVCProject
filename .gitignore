## Visual Studio / ASP.NET MVC .gitignore

# Build output
bin/
obj/

# NuGet packages
packages/
*.nupkg
!packages/repositories.config

# User-specific files
*.user
*.userosscache
*.sln.docstates
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet
*.nuget.props
*.nuget.targets

# Publish output
publish/
PublishProfiles/
*.pubxml
*.pubxml.user

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Visual Studio cache/options directory
.vs/
*.VC.db
*.VC.VC.opendb

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
